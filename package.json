{
  "name": "@wrk-t/communication",
  "version": "0.1.0",
  "description": "Communication infrastructure for NestJS — email sending via SMTP (nodemailer), with plans for SMS, OTP, and other notification channels.",
  "license": "MIT",
  "author": "emadi68moh@gmail.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/wrk-t/communication"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./*": "./dist/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "format": "npx @biomejs/biome format --write .",
    "lint": "npx @biomejs/biome lint --write .",
    "check": "npx @biomejs/biome check --write .",
    "hooks:install": "npx lefthook install",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "nodemailer": "^6.9.16"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/config": ">=3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.2",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^6.4.17",
    "lefthook": "^1.11.13",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "nestjs",
    "communication",
    "email",
    "smtp",
    "nodemailer",
    "notification",
    "otp"
  ]
}
